{
  "mcpServers": {
    "perplexity": {
      "type": "http",
      "url": "https://api.perplexity.ai/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.81",
        "--headless",
        "--isolated",
        "--no-sandbox",
        "--executable-path",
        "${PLAYWRIGHT_CHROMIUM_PATH:-/opt/pw-browsers/chromium}"
      ],
      "env": {
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    }
  }
}
